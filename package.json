{
  "name": "cheat-string-diff-gui",
  "version": "1.0.0",
  "description": "GUI for differential string analysis of Minecraft cheat memory dumps",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node test/smoke.js"
  },
  "keywords": [
    "anti-cheat",
    "memory-dump",
    "yara",
    "forensics"
  ],
  "license": "UNLICENSED",
  "type": "commonjs",
  "productName": "Cheat String Diff",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "local.cheatstringdiff",
    "productName": "Cheat String Diff",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
